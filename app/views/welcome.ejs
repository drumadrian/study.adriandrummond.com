<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - Study Server</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-primary: #f8fafc;
            --text-secondary: #cbd5e1;
            --accent-glow: rgba(56, 189, 248, 0.5);
            --btn-bg: rgba(56, 189, 248, 0.1);
            --btn-border: rgba(56, 189, 248, 0.4);
            --btn-hover: rgba(56, 189, 248, 0.3);
            --danger-bg: rgba(239, 68, 68, 0.15);
            --danger-border: rgba(239, 68, 68, 0.4);
            --danger-hover: rgba(239, 68, 68, 0.35);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body { 
            font-family: 'Inter', sans-serif; 
            background: var(--bg-gradient);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding: 20px 40px; 
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--glass-border);
            z-index: 10;
        }

        .header h2 { 
            font-weight: 700; 
            font-size: 22px; 
            letter-spacing: 1px;
            background: linear-gradient(90deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .user-info { 
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-details {
            text-align: right;
            display: flex;
            flex-direction: column;
        }

        .user-details strong { 
            font-size: 15px; 
            font-weight: 600;
        }
        
        .user-details small { 
            color: var(--text-secondary); 
            font-size: 12px;
        }

        .logout-btn { 
            padding: 8px 16px; 
            background: var(--danger-bg); 
            border: 1px solid var(--danger-border);
            color: white; 
            text-decoration: none; 
            border-radius: 8px; 
            font-size: 13px; 
            font-weight: 600;
            transition: all 0.3s ease; 
        }

        .logout-btn:hover { 
            background: var(--danger-hover); 
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
            transform: translateY(-1px);
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            position: relative;
        }

        /* Decorative Orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            opacity: 0.6;
        }

        .orb-1 {
            width: 300px;
            height: 300px;
            background: #38bdf8;
            top: 10%;
            left: 20%;
            animation: float 8s ease-in-out infinite;
        }

        .orb-2 {
            width: 400px;
            height: 400px;
            background: #818cf8;
            bottom: 10%;
            right: 15%;
            animation: float 10s ease-in-out infinite reverse;
        }

        @keyframes float {
            0% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-30px) scale(1.05); }
            100% { transform: translateY(0px) scale(1); }
        }

        .glass-container { 
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 900px; 
            padding: 60px 50px; 
            background: var(--glass-bg); 
            border: 1px solid var(--glass-border);
            border-radius: 24px; 
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); 
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            text-align: center; 
            animation: fadeIn 1s ease-out forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1 { 
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 15px;
            letter-spacing: -0.5px;
            color: #fff;
        }

        p.subtitle { 
            color: var(--text-secondary); 
            font-size: 1.15rem; 
            font-weight: 300;
            margin-bottom: 50px;
            line-height: 1.6;
        }

        .app-grid { 
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

        .app-card { 
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 35px 25px; 
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            text-decoration: none; 
            border-radius: 16px; 
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
            group: card;
        }

        .app-card:hover { 
            background: var(--btn-bg);
            border-color: var(--btn-border);
            transform: translateY(-10px) scale(1.02); 
            box-shadow: 0 15px 30px rgba(0,0,0,0.3), 0 0 20px var(--accent-glow);
        }

        .app-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.3s ease;
        }

        .app-card:hover .app-icon {
            transform: scale(1.1);
        }

        .app-title {
            color: #fff;
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .app-desc {
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 300;
        }

        /* SVG Icons defined inline for neatness */
        .svg-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 20px;
            stroke: url(#icon-gradient);
            stroke-width: 1.5;
            fill: none;
            transition: all 0.3s ease;
        }
        
        .app-card:hover .svg-icon {
            transform: scale(1.15);
            filter: drop-shadow(0 0 8px var(--accent-glow));
        }

    </style>
</head>
<body>
    <svg style="width:0;height:0;position:absolute;" aria-hidden="true" focusable="false">
      <linearGradient id="icon-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" />
        <stop offset="100%" stop-color="#818cf8" />
      </linearGradient>
    </svg>

    <header class="header">
        <h2>Study Server</h2>
        <div class="user-info">
            <div class="user-details">
                <strong><%= user.username || 'Authenticated User' %></strong>
                <small><%= user.email %></small>
            </div>
            <a href="/logout" class="logout-btn">Sign Out</a>
        </div>
    </header>

    <main class="main-wrapper">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        
        <div class="glass-container">
            <h1>Welcome Back</h1>
            <p class="subtitle">Your private environment is secure and ready. Select a service below to begin your session.</p>
            
            <div class="app-grid">
                <a href="https://wiki.adriandrummond.com" class="app-card">
                    <svg class="svg-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                    <div class="app-title">Wiki.JS</div>
                    <div class="app-desc">Knowledge Base & Docs</div>
                </a>
                
                <a href="/opensearchdashboards" class="app-card">
                    <svg class="svg-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                        <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
                    </svg>
                    <div class="app-title">OS Dashboards</div>
                    <div class="app-desc">Data Analytics & Viz</div>
                </a>

                <a href="/opensearch" class="app-card">
                    <svg class="svg-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                    <div class="app-title">OpenSearch DB</div>
                    <div class="app-desc">Raw Index Access</div>
                </a>
            </div>
        </div>
    </main>
</body>
</html>
