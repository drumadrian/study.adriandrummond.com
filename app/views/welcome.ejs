<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - Study Server</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f4f4f9; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; background-color: #2c3e50; color: white; }
        .header h2 { margin: 0; font-size: 24px; font-weight: normal; }
        .user-info { text-align: right; }
        .user-info strong { font-size: 16px; }
        .user-info small { color: #bdc3c7; margin-left: 5px; }
        .user-info a { display: inline-block; padding: 6px 12px; margin-left: 20px; background-color: #e74c3c; color: white; text-decoration: none; border-radius: 4px; font-size: 14px; transition: background-color 0.3s; }
        .user-info a:hover { background-color: #c0392b; }
        .container { max-width: 800px; margin: 50px auto; padding: 40px; background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center; }
        h1 { color: #34495e; }
        p { color: #7f8c8d; font-size: 18px; }
        .links { margin-top: 30px; }
        .links a { display: inline-block; margin: 10px; padding: 12px 24px; background-color: #3498db; color: white; text-decoration: none; border-radius: 5px; font-weight: bold; transition: background-color 0.3s; }
        .links a:hover { background-color: #2980b9; }
    </style>
</head>
<body>
    <div class="header">
        <h2>Study Server</h2>
        <div class="user-info">
            <strong><%= user.username || 'User' %></strong>
            <small>(<%= user.email %>)</small>
            <a href="/logout">Logout</a>
        </div>
    </div>
    <div class="container">
        <h1>Welcome to your Study Server!</h1>
        <p>Authentication was successful. You are securely logged in via Amazon Cognito.</p>
        <div class="links">
            <a href="/wiki">Wiki.JS Dashboard</a>
            <a href="/opensearchdashboards">OpenSearch Analytics</a>
        </div>
    </div>
</body>
</html>
