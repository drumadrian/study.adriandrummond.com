# study.adriandrummond.com Server Configuration

# Domain Name (used for hostname and S3 buckets)
DOMAIN_NAME="study.adriandrummond.com"

# AWS Configuration
AWS_REGION="us-east-1"
SQS_QUEUE_NAME="notes"

# PostgreSQL Configuration for Wiki.js
POSTGRES_DB="wikijs"
POSTGRES_USER="wikijs_user"
POSTGRES_PASSWORD="your_postgres_password_here"

# OpenSearch Configuration
OPENSEARCH_ADMIN_PASSWORD="your_opensearch_password_here"

# Cognito Configuration
COGNITO_USER_POOL_ID="your_user_pool_id_here"
COGNITO_CLIENT_ID="your_client_id_here"
COGNITO_CLIENT_SECRET="your_client_secret_here"
COGNITO_DOMAIN="your_cognito_domain_here"
COGNITO_IDENTITY_POOL_ID="your_identity_pool_id_here"

# Infrastructure Configuration
VPC_ID="your_vpc_id_here"
SUBNET_ID="your_subnet_id_here"
SG_ID="your_sg_id_here"
INSTANCE_ID="your_instance_id_here"
PUBLIC_IP="your_public_ip_here"
KEY_PATH="certificates/your_key_file.pem"

# API Tokens
KAGGLE_API_TOKEN="your_kaggle_api_token_here"

# Server Access
# RHEL RDP password for ec2-user
RDP="your_rdp_password_here"
